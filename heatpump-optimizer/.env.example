# Panasonic Aquarea credentials
AQUAREA_USERNAME=your_email@example.com
AQUAREA_PASSWORD=your_password

# Database
POSTGRES_USER=heatpump
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=heatpump
# DATABASE_URL is constructed automatically by docker-compose from the above vars

# Redis
REDIS_URL=redis://redis:6379/0

# Price feed
# PRICE_PROVIDER=entsoe        # "entsoe" (default) or "tibber"
# ENTSO-E (free token at https://transparency.entsoe.eu/)
ENTSOE_API_TOKEN=your_entsoe_token
ENTSOE_AREA=10YNL----------L
# Tibber (only when PRICE_PROVIDER=tibber, https://developer.tibber.com/)
# TIBBER_API_TOKEN=your_tibber_token

# Weather (open-meteo default, no key needed; alternatives: "smhi" for Nordic/
# Baltic coverage, or "manual". Set via the Weather Provider setting in the UI.)
LATITUDE=52.37
LONGITUDE=4.89

# SmartThings indoor temperature (optional)
# Preferred: OAuth — create a SmartApp with `smartthings apps:create`
# SMARTTHINGS_CLIENT_ID=
# SMARTTHINGS_CLIENT_SECRET=
# SMARTTHINGS_REDIRECT_URI=http://localhost:8500/api/smartthings/oauth/callback
# Legacy fallback: Personal Access Token
# SMARTTHINGS_PAT=

# Optimizer settings
TANK_MIN_TEMP=45
TANK_MIN_TEMP_OFFPEAK=41
TANK_MAX_TEMP=55
COMFORT_TEMP_MIN=20.0
COMFORT_TEMP_MAX=22.0

# System hardware
TANK_VOLUME_LITERS=300
SH_MAX_POWER_KW=12.0

# App
# Use production only together with a unique SECRET_KEY and API_TOKEN. The
# application fails closed if either is left at its development value.
# APP_ENVIRONMENT=production
# SECRET_KEY is required in production; changing it invalidates persisted ML models
SECRET_KEY=change-this-to-a-random-string
# Set API_TOKEN to a strong random string to require Bearer auth on /api/*
# API_TOKEN=disabled
# CORS_ORIGINS=http://localhost:3500
# MODEL_DIR=/app/models
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300

# Database protection. Backups are written to ./backups (ignored by git).
# Set BACKUP_VERIFY_AFTER_DUMP=true to restore every completed backup into a
# disposable database before accepting it; this adds database I/O.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
BACKUP_VERIFY_AFTER_DUMP=false
# Optional encrypted off-host copy. Point BACKUP_REPLICA_HOST_DIR to a mounted
# NAS/share; it stays disabled until explicitly enabled. Keep the key outside
# source control (prefer a secret manager in production).
BACKUP_REPLICA_ENABLED=false
BACKUP_REPLICA_REQUIRED=false
BACKUP_MAX_AGE_SECONDS=93600
# BACKUP_REPLICA_HOST_DIR=Z:/heatpump-backups
# BACKUP_REPLICA_ENCRYPTION_KEY=generate-a-long-random-secret

# Ports (host-side mapping, change to avoid conflicts)
DB_PORT=5434
API_PORT=8500
WEB_PORT=3500
