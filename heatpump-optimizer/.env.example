# Panasonic Aquarea credentials
AQUAREA_USERNAME=your_email@example.com
AQUAREA_PASSWORD=your_password

# Database
POSTGRES_USER=heatpump
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=heatpump
DATABASE_URL=postgresql+asyncpg://heatpump:changeme_in_production@db:5432/heatpump

# Redis
REDIS_URL=redis://redis:6379/0

# Price feed (ENTSO-E - get free token at https://transparency.entsoe.eu/)
ENTSOE_API_TOKEN=your_entsoe_token
ENTSOE_AREA=10YNL----------L

# Weather (open-meteo, no key needed)
LATITUDE=52.37
LONGITUDE=4.89

# Optimizer settings
TANK_MIN_TEMP=45
TANK_MAX_TEMP=55
COMFORT_TEMP_MIN=20.0
COMFORT_TEMP_MAX=22.0
DHW_READY_BY_HOURS=6,18

# App
SECRET_KEY=change-this-to-a-random-string
LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300
